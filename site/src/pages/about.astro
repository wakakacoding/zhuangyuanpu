---
import { allPersons, fullProfileIds, BASE } from '../lib/persons';
import { listStories } from '../lib/story';
import { coverageStats, GOALS, pct } from '../lib/coverage';
import SeoHead from '../components/SeoHead.astro';
import SiteNav from '../components/SiteNav.astro';
import '../styles/base.css';

const persons = allPersons();
const n = persons.length;
const fullIds = fullProfileIds();
const stories = listStories();

// 补全计划进度：与 /stats 同源，全部构建期实测（见 src/lib/coverage.ts），不手写数字
const cov = coverageStats();
const byKey = Object.fromEntries(cov.items.map((i) => [i.key, i]));
const coverage = [
  { ...byKey.persons, note: `目标：可考的历代文状元全量；另有特例 ${cov.roles.special} 人单列（探花 ${cov.roles.tanhua} · 事实状元 ${cov.roles.deFacto}），不并入此数` },
  { ...byKey.stories, note: '长篇叙事，杂志级' },
  { ...byKey.coords, note: '60% 达标解锁完整籍贯地图' },
];

// API 端点绝对地址（供 curl 示例，避免手写域名）
const apiBase = new URL(`${import.meta.env.BASE_URL}api/`, Astro.site ?? new URL('https://wakakacoding.github.io')).href;

// ---- 分层许可（R0-1/R0-2）：授权协议原文与「数据血缘」清单 ----
// 血缘清单里的覆盖数全部构建期实测（persons 卡 + coverageStats 的关系边），不手写数字。
const SELF_CC = 'https://creativecommons.org/licenses/by-sa/4.0/deed.zh';
const CBDB_CC = 'https://creativecommons.org/licenses/by-nc-sa/4.0/deed.zh';
const CBDB_TERMS = 'https://cbdb.hsites.harvard.edu/cbdb-data-licensing-terms';
const CBDB_HOME = 'https://cbdb.hsites.harvard.edu/';
const CBDB_RELEASE = 'cbdb_20261010';

const cnt = (f) => persons.filter(f).length;
const lin = {
  fl: cnt((p) => p.fl_year),
  birth: cnt((p) => p.birth_year),
  death: cnt((p) => p.death_year),
  zi: cnt((p) => p.zi),
  hao: cnt((p) => p.hao),
  native: cnt((p) => p.native_hist),
};
---

<html lang="zh-CN">
  <head>
    <SeoHead title="关于" description="关于状元谱：项目缘起、数据源（CBDB / 题名碑录 / 正史 / 登科记考）、A/B/C 三级考证方法论与补全计划。" path="/about/" />
  </head>
  <body>
    <div class="container">
      <header class="site-head">
        <h1>关于本站</h1>
        <p class="sub">每条信息都该经得起追问：本站是什么、数据从哪来、凭什么可信。</p>
        <SiteNav current="/about/" />
      </header>

      <section>
        <h2 class="section-title">项目缘起</h2>
        <p>
          唐武德五年（622），孙伏伽成为中国历史上有名可考的第一位状元；
          清光绪三十年（1904），刘春霖在甲辰恩科中夺魁，成为「第一人中最后人」。
          一头一尾，<b>1283 年</b>，科举史上共留下 <b>600 余位</b>文状元的名字。
        </p>
        <p>
          这六百余人是中国一千三百年选官制度金字塔的塔尖：有人拜相封侯、青史留名，
          有人英年早逝、只留下籍贯与名次；同一串名字背后，是地域重心的南移、
          家族与师承的网络、以及一个王朝如何挑选它的精英。
          本站想回答一个朴素的问题——<b>这些「天下第一」后来都怎么样了？</b>
        </p>
        <p>
          做法是两条腿走路：一边是有温度、可阅读的<b>长篇故事</b>，
          一边是可查证、带出处编号的<b>结构化数据底座</b>——目标是做成「状元领域的 CBDB」。
        </p>
      </section>

      <section>
        <h2 class="section-title">数据源</h2>
        <p class="note-line">以一手史料为骨、权威数据库为底，地方文献补阙。每条入库数据均须挂出处编号。</p>
        <div class="src-grid">
          <div class="src-card">
            <h3>《登科记考》</h3>
            <p class="src-tag">清 · 徐松 · 三十卷</p>
            <p>唐五代科举史料集大成之作，逐科考辨登第者姓名与科年，有中华书局点校本。唐五代段名录的主要依据。</p>
          </div>
          <div class="src-card">
            <h3>《明清进士题名碑录》</h3>
            <p class="src-tag">据北京国子监进士题名碑整理</p>
            <p>明清两代姓名、籍贯、名次的一手证据——碑刻立于放榜之时，是最难作伪的那类史料。</p>
          </div>
          <div class="src-card">
            <h3>正史列传</h3>
            <p class="src-tag">二十四史 + 《清史稿》</p>
            <p>人物仕宦、生卒、著述的主干来源。入传者只是少数，但这少数构成了考证的锚点。</p>
          </div>
          <div class="src-card">
            <h3>CBDB 中国历代人物传记资料库</h3>
            <p class="src-tag">哈佛 / 北大 / 中研院合作项目</p>
            <p>
              50 万+ 人物结构化数据，含科举年份、籍贯、社会关系与估算活动年（fl_year）。
              本站冷启动的底座，逐条与一手史料交叉核对。
              <span class="src-lic">本站取自该库的字段以 CC BY-NC-SA 4.0 使用：须署名 CBDB、不得商用。</span>
            </p>
          </div>
        </div>
        <p class="note-line">另参：地方志「选举志」、年谱、墓志、朱卷与登科录等；全部出处逐条登记于数据层，页面可展开查证。</p>
      </section>

      <section>
        <h2 class="section-title">考证方法论</h2>

        <h3 class="sub-title">三级出处：给每条信息一个可信度</h3>
        <div class="tier-list">
          <div class="tier-row">
            <span class="tier tier-A">A</span>
            <div>
              <b>正史 / 题名碑 / 朱卷 / 登科录</b>
              <p>原始或接近原始的记录。任何字段无出处不得标 A 级；A 级结论须两个以上独立来源支撑。</p>
            </div>
          </div>
          <div class="tier-row">
            <span class="tier tier-B">B</span>
            <div>
              <b>地方志 / 年谱 / 墓志 / 回忆录</b>
              <p>二手但严肃的文献，用于补正史之阙、证生平细节。</p>
            </div>
          </div>
          <div class="tier-row">
            <span class="tier tier-C">C</span>
            <div>
              <b>笔记小说 / 民间传说</b>
              <p>可以入站，但与史实<b>物理隔离</b>：单独归入轶事，前端明确标注「传说」，绝不允许混入年表。</p>
            </div>
          </div>
        </div>

        <h3 class="sub-title">异说并存：不强行定论</h3>
        <p>
          生卒年、籍贯有争议时，存多个版本并各挂出处，并列展示、标注「存疑」。
          正史沉默处的合法分歧，呈现分歧比强行统一更诚实。
        </p>

        <h3 class="sub-title">史料阙如，合法</h3>
        <p>
          榜上有名而史中无传，本身就是历史事实——它说明寒门夺魁后的仕途天花板、
          说明史料保存的偏向。凡遇此情形，页面如实标注<span class="quelu">史料阙如</span>，
          不编造、不脑补、不用传说填空。
        </p>
        <p>
          但「没有记载」与「还没去查」是两回事：<b>「史料阙如」须经人工查证认定</b>（人物卡标 <code>verified_absent: true</code>）方可使用；
          尚未整理的缺载一律表述为「待考」「待整理」——整理进度不冒充历史结论。
        </p>
      </section>

      <section class="plan">
        <h2 class="section-title plan-title">补全计划</h2>
        <p class="plan-note">历代榜上有名者六百余人，本站已录状元 {cov.zhuangyuan} 人；史中留痕者寥寥。缺漏不遮不掩，进度公开——这本身就是本站要讲的故事。数据为构建时统计。</p>
        <p class="plan-note">
          口径：人物的统计总体是<b>状元</b>（当前 {cov.zhuangyuan} 人）；人物卡另有<b>特例 {cov.roles.special} 人</b>——
          {cov.roles.tanhua > 0 && <>探花 {cov.roles.tanhua} 人（商衍鎏）、</>}
          事实状元 {cov.roles.deFacto} 人（赵楷），因科举史料价值收录，<b>不并入状元总数与各分布</b>。
        </p>
        <div class="plan-bars">
          {coverage.map((c) => {
            const p = pct(c.cur, c.total);
            const hit = c.target != null && c.cur / c.total >= c.target;
            return (
              <div class="bar-row">
                <span class="bar-label">{c.label}</span>
                <span class="bar-track">
                  <span class={`bar-fill${hit ? ' hit' : ''}`} style={`width:${Math.min(100, p).toFixed(1)}%`}></span>
                  {c.target != null && <span class="bar-target" style={`left:${c.target * 100}%`}></span>}
                </span>
                <span class="bar-num">{c.cur} / {c.total}{c.target != null ? ` · ${p.toFixed(0)}%` : ''}</span>
                <span class="bar-note">{c.note}</span>
              </div>
            );
          })}
        </div>
        <p class="plan-note">另有全字段档案（含仕途时间线）已建 {fullIds.size} / {GOALS.fullProfile}；坐标覆盖率达 60% 解锁完整籍贯地图。完整看板见<a href={`${BASE}stats/`}>统计页</a>。</p>
      </section>

      <section id="download" class="download">
        <h2 class="section-title">数据下载</h2>
        <p class="note-line">
          全站数据底座<b>分层开放</b>：本站自主编纂的部分以 <b>CC BY-SA 4.0</b> 发布（含商用）；
          取自 CBDB 的派生字段以 <b>CC BY-NC-SA 4.0</b> 发布（<b>不得商用</b>、须署名 CBDB）——
          逐字段归属见下方「许可与引用」。构建期自动导出为静态 API，随每次构建刷新（当前 {cov.generated}）。
          没有密钥、没有速率限制；数据即本站正文的可机读形态，欢迎复刻、校验与引证。
        </p>

        <div class="dl-grid">
          <a class="dl-card" href={`${BASE}api/persons.json`}>
            <h3>persons.json <span class="dl-size">全量精简字段</span></h3>
            <p><b>{cov.persons}</b> 张人物卡（状元 {cov.zhuangyuan} · 特例 {cov.roles.special}），一人一条：姓名、朝代、科年干支、名次、生卒、籍贯与今地坐标、小传、标签。</p>
            <span class="dl-go">下载 JSON →</span>
          </a>
          <a class="dl-card" href={`${BASE}api/persons.csv`}>
            <h3>persons.csv <span class="dl-size">表格版</span></h3>
            <p>同上字段集，UTF-8 无 BOM、LF 换行。适合 Excel / pandas 直接读入做统计与制图。</p>
            <span class="dl-go">下载 CSV →</span>
          </a>
          <a class="dl-card" href={`${BASE}api/`}>
            <h3>数据字典 <span class="dl-size">api/README.md</span></h3>
            <p>逐字段释义、子文档结构（生平事件 / 著作 / 轶事 / 关系 / 出处）、A-B-C 三级可信度约定与许可条款。</p>
            <span class="dl-go">阅读字典 →</span>
          </a>
          <a class="dl-card" href={`${BASE}api/index.json`}>
            <h3>index.json <span class="dl-size">清单</span></h3>
            <p>版本号、生成日期、各表条目数与端点表——程序化接入时先读它。</p>
            <span class="dl-go">查看清单 →</span>
          </a>
        </div>

        <h3 class="sub-title">单人全字段</h3>
        <p>
          每位状元另有 <code>/api/persons/&lt;id&gt;.json</code>，含档案全字段、生平事件、著作、轶事、
          人物关系，以及该人所引史料的原文摘录与卷次。例如
          {' '}<a class="inline-link" href={`${BASE}api/persons/wen_tianxiang.json`}>文天祥</a>
          {' '}、<a class="inline-link" href={`${BASE}api/persons/sun_fujia.json`}>孙伏伽</a>。
        </p>
        <pre class="dl-code"><code>curl -s {apiBase}persons.json | jq '.meta.count, .persons[0].name'</code></pre>

        <h3 class="sub-title">许可与引用（分层）</h3>
        <p class="note-line">
          本站的数据是<b>两层材料的叠加</b>，两层授权不同，请分别遵循；逐字段归属见下方血缘清单。
        </p>
        <ul class="dl-license">
          <li>
            <b>① 本站自主编纂内容 —— CC BY-SA 4.0（含商用）</b>：人物档案的编纂与标点、A/B/C 三级考证结论、
            生平事件／著作／轶事与出处的登记编排、人物关系中的人工条目、长篇故事正文。
            以 <b>CC BY-SA 4.0</b> 发布（<a class="inline-link" href={SELF_CC}>协议原文</a>）：
            可自由复制、分发、改编（<b>含商用</b>），条件为署名「数据来源：状元谱」并以相同方式共享。
          </li>
          <li>
            <b>② CBDB 派生数据 —— CC BY-NC-SA 4.0（不得商用，须署名）</b>：取自
            《中国历代人物传记资料库》（CBDB，哈佛大学／北京大学／中央研究院合作项目）。依《CBDB Data Licensing Terms》
            （<a class="inline-link" href={CBDB_TERMS}>条款原文</a>，2026-08-20 生效），属「当前单机版范围内」的 CBDB 数据适用
            {' '}<b>CC BY-NC-SA 4.0</b>（<a class="inline-link" href={CBDB_CC}>协议原文</a>）：
            <b>须注明 CBDB 为数据来源并标明所用版本</b>，<b>不得用于商业目的</b>，改编后须以相同协议共享。
            该库主页见 <a class="inline-link" href={CBDB_HOME}>cbdb.hsites.harvard.edu</a>。
            <b>「含商用」只覆盖第 ① 层</b>，不含本层。
          </li>
          <li>
            <b>③ 史料原文 —— 不在上述任一授权范围内</b>：<code>sources[].quote</code> 等古籍摘录，
            版权属原书及其点校本，本站仅作考证性引用，转引请回查原书。
          </li>
          <li>
            数据不担保无误：<b>引用前请回溯出处原文</b>。发现错误请走<a href={`${BASE}corrections/`}>勘误</a>流程。
          </li>
        </ul>

        <h4 class="lic-h">数据血缘清单：哪个字段属于哪一层</h4>
        <div class="lic-table">
          <table>
            <thead>
              <tr><th>数据（当前覆盖）</th><th>实际出处</th><th>层级</th></tr>
            </thead>
            <tbody>
              <tr>
                <td><code>fl_year</code> 估算活动年（{lin.fl} / {n}）</td>
                <td>CBDB <code>BIOG_MAIN.c_index_year</code>，经 <code>fill_lifespan.py</code> 回填（仅补空）</td>
                <td><span class="lic-tag lic-2">②</span></td>
              </tr>
              <tr>
                <td><code>birth_year</code> / <code>death_year</code> 机器回填部分（现有值 {lin.birth} / {lin.death}）</td>
                <td>CBDB <code>BIOG_MAIN.c_birthyear</code> / <code>c_deathyear</code>；已有人工考证值不被覆盖</td>
                <td><span class="lic-tag lic-2">②</span></td>
              </tr>
              <tr>
                <td><code>zi</code> / <code>hao</code> 经索引带入者（{lin.zi} / {lin.hao}）</td>
                <td>CBDB <code>ALTNAME_DATA</code>（类型 4=字 / 5=号）</td>
                <td><span class="lic-tag lic-2">②</span></td>
              </tr>
              <tr>
                <td><code>native_hist</code> / <code>native_modern</code> 籍贯（{lin.native}）</td>
                <td>CBDB <code>BIOG_ADDR_DATA</code>（type=1）优先，名录籍贯兜底</td>
                <td><span class="lic-tag lic-2">②</span></td>
              </tr>
              <tr>
                <td>关系机器收割边（{cov.relations.external} / {cov.relations.total} 条，<code>to_id</code> 前缀 <code>cbdb:</code>）</td>
                <td>CBDB <code>ASSOC_DATA</code> + <code>KIN_DATA</code>，经 <code>harvest_cbdb_relations.py</code> 收割</td>
                <td><span class="lic-tag lic-2">②</span></td>
              </tr>
              <tr>
                <td>考证结论、事件／著作／轶事／出处登记、故事正文、人工关系条目</td>
                <td>正史／题名碑录／登科记考／方志等一手二手史料 + 本站编纂</td>
                <td><span class="lic-tag lic-1">①</span></td>
              </tr>
              <tr>
                <td><code>sources[].quote</code> 古籍原文</td>
                <td>原书及点校本</td>
                <td><span class="lic-tag lic-3">③</span></td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="note-line">
          口径说明：第 ② 层为<b>保守下限声明</b>——凡取值可能来自 CBDB 的字段一律标 ②，
          个别记录实际另有名录或一手史料来源，以该条记录的出处链为准；
          所用 CBDB 数据版本为 <code>{CBDB_RELEASE}</code>（官方单机版 SQLite 发行版）。
          本站为非商业项目，第 ② 层仅在非商业前提下使用。
        </p>
        <p class="note-line">
          数据条目数（构建期实测）：{' '}
          {cov.sourceItems.map((s, i) => (
            <span>{i > 0 ? ' · ' : ''}{s.label} {s.n} {s.unit}</span>
          ))}
        </p>
      </section>

      <section class="corr-entry">
        <h2 class="section-title">发现错误？</h2>
        <p>
          本站所有结论均可追问出处，也欢迎被推翻。勘误走「读者提交 → 人工比对 → Git 留痕」流程，
          72 小时内响应；采信、驳回、异说备录，全部公开可查。
        </p>
        <a class="corr-btn" href={`${BASE}corrections/`}>前往勘误页 →</a>
      </section>

      <a class="back" href={BASE}>← 返回首页</a>
    </div>

    <style>
      section p { font-size: 0.95rem; }
      .sub-title { font-size: 1rem; margin: 1.6rem 0 0.6rem; }

      /* 数据源卡片 */
      .src-grid { display: grid; gap: 0.9rem; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); margin: 1rem 0 0.8rem; }
      .src-card {
        border: 1px solid var(--line); background: #fbf8f0;
        border-radius: 4px; padding: 1rem 1.1rem;
      }
      .src-card h3 { margin: 0; font-size: 1.02rem; }
      .src-tag { margin: 0.25rem 0 0.5rem; font-size: 0.78rem; color: var(--cinnabar); }
      .src-card p:last-child { margin: 0; font-size: 0.87rem; color: var(--ink-soft); }
      .src-lic { display: block; margin-top: 0.4rem; font-size: 0.78rem; color: var(--cinnabar); }

      /* 三级出处 */
      .tier-list { display: flex; flex-direction: column; gap: 0.7rem; margin: 0.6rem 0 0.4rem; }
      .tier-row {
        display: flex; gap: 0.9rem; align-items: flex-start;
        border: 1px solid var(--line); border-radius: 4px;
        background: #fbf8f0; padding: 0.8rem 1rem;
      }
      .tier-row .tier { flex: 0 0 auto; font-size: 0.9rem; padding: 0.1rem 0.55rem; margin-top: 0.15rem; }
      .tier-row p { margin: 0.15rem 0 0; font-size: 0.87rem; color: var(--ink-soft); }

      /* 补全计划（呼应首页 plan 样式） */
      .plan { border: 1px dashed var(--gold); border-radius: 4px; padding: 1rem 1.2rem 1.2rem; background: var(--paper-deep); }
      .plan-title { margin-top: 0.2rem; border-left-color: var(--gold); }
      .plan-note { margin: 0 0 0.9rem; font-size: 0.85rem; color: var(--ink-soft); }
      .plan-note:last-child { margin: 0.9rem 0 0; }
      .plan-bars { display: flex; flex-direction: column; gap: 0.55rem; }
      .bar-row { display: flex; align-items: center; gap: 0.7rem; font-size: 0.85rem; flex-wrap: wrap; }
      .bar-label { flex: 0 0 4.5em; color: var(--ink-soft); }
      .bar-track {
        flex: 1 1 12rem; height: 0.9rem; background: #e4dccb;
        border-radius: 2px; overflow: hidden; position: relative;
      }
      .bar-fill { display: block; height: 100%; background: var(--cinnabar); border-radius: 2px; }
      .bar-fill.hit { background: #4a7c59; }
      .bar-target { position: absolute; top: 0; bottom: 0; width: 2px; background: var(--ink); }
      .bar-num { flex: 0 0 auto; color: var(--ink-soft); font-variant-numeric: tabular-nums; }
      .bar-note { flex: 0 0 100%; margin: -0.35rem 0 0 calc(4.5em + 0.7rem); font-size: 0.75rem; color: var(--ink-soft); }

      /* 数据下载 */
      .download { border-top: 2px solid var(--ink); padding-top: 0.2rem; }
      .dl-grid { display: grid; gap: 0.9rem; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); margin: 1rem 0 1.4rem; }
      .dl-card {
        display: block; text-decoration: none; color: inherit;
        border: 1px solid var(--line); border-left: 4px solid var(--gold);
        background: #fbf8f0; border-radius: 4px; padding: 0.9rem 1.1rem 0.8rem;
      }
      .dl-card:hover { box-shadow: 3px 3px 0 var(--ink); }
      .dl-card h3 { margin: 0; font-size: 1rem; }
      .dl-card .dl-size {
        font-size: 0.7rem; color: var(--cinnabar); border: 1px solid var(--cinnabar);
        border-radius: 999px; padding: 0 0.45rem; margin-left: 0.4rem; vertical-align: 0.15em;
      }
      .dl-card p { margin: 0.4rem 0 0.5rem; font-size: 0.85rem; color: var(--ink-soft); }
      .dl-card .dl-go { font-size: 0.82rem; color: var(--cinnabar); }
      .inline-link { color: var(--cinnabar); text-decoration: none; }
      .inline-link:hover { text-decoration: underline; }
      .dl-code {
        margin: 0.6rem 0 0; padding: 0.6rem 0.9rem; overflow-x: auto;
        background: var(--paper-deep); border-left: 3px solid var(--ink);
        font-size: 0.78rem; line-height: 1.7;
      }
      .dl-code code { font-family: ui-monospace, "SF Mono", Menlo, monospace; }
      .dl-license { margin: 0.5rem 0 0; padding-left: 1.2rem; font-size: 0.88rem; }
      .dl-license li { margin: 0.35rem 0; color: var(--ink-soft); }
      .dl-license b { color: var(--ink); }

      /* 分层许可 · 数据血缘清单 */
      .lic-h { font-size: 0.95rem; margin: 1.3rem 0 0.5rem; }
      .lic-table { overflow-x: auto; }
      .lic-table table {
        width: 100%; border-collapse: collapse; font-size: 0.82rem;
        border: 1px solid var(--line); background: #fbf8f0;
      }
      .lic-table th, .lic-table td {
        border: 1px solid var(--line); padding: 0.45rem 0.6rem;
        text-align: left; vertical-align: top; line-height: 1.6;
      }
      .lic-table th { background: var(--paper-deep); font-weight: 600; white-space: nowrap; }
      .lic-table td:last-child { text-align: center; white-space: nowrap; }
      .lic-table code { font-size: 0.95em; }
      .lic-tag {
        display: inline-block; min-width: 1.4em; text-align: center;
        font-size: 0.78rem; border-radius: 2px; padding: 0 0.35rem; color: #fff;
      }
      .lic-1 { background: #4a7c59; }
      .lic-2 { background: var(--cinnabar); }
      .lic-3 { background: #7a6a4f; }
      #download code {
        background: var(--paper-deep); border-radius: 2px; padding: 0 0.25rem;
        font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: 0.85em;
      }
      #download .note-line:last-child { margin-top: 0.9rem; }

      /* 勘误入口 */
      .corr-entry p { font-size: 0.95rem; }
      .corr-btn {
        display: inline-block; margin-top: 0.4rem; text-decoration: none;
        background: var(--cinnabar); color: #fff; font-size: 0.9rem;
        padding: 0.35rem 1.2rem; border-radius: 3px; letter-spacing: 0.1em;
      }
      .corr-btn:hover { box-shadow: 3px 3px 0 var(--ink); }

      @media (max-width: 640px) {
        .bar-label { flex-basis: 4em; }
        .bar-note { margin-left: 0; }
      }
    </style>
  </body>
</html>
