---
import fs from 'node:fs';
import path from 'node:path';
import { listStories } from '../lib/story';
import SeoHead from '../components/SeoHead.astro';
import '../styles/base.css';
import '../styles/story.css';
import {
  BASE, allPersons, fullProfileIds, isSpecialRole, profileStatusText, roleOf, ROLE_LABEL, ROLE_NOTE,
} from '../lib/persons';
import { coverageStats, GOALS } from '../lib/coverage';

const persons = allPersons();
const fullIds = fullProfileIds();
const withEvents = persons.filter((p) => fullIds.has(p.id));

const stories = listStories();
const [featured, ...rest] = stories;

// 星图入口卡：星点数与年份区间取自构建期产物（build_galaxy.py 先于页面渲染执行），
// 读不到就降级为不带数字的文案——首页不该因为一张入口卡而构建失败
let galaxy: { n: number; from: number; to: number; gold: number } | null = null;
try {
  const g = JSON.parse(
    fs.readFileSync(path.resolve(process.cwd(), 'public/data/galaxy.json'), 'utf8'),
  ) as { stars: Array<{ t: number }>; xr: [number, number] };
  galaxy = {
    n: g.stars.length,
    from: g.xr[0],
    to: g.xr[1],
    gold: g.stars.filter((s) => s.t === 0).length,
  };
} catch {
  galaxy = null;
}

// 补全计划进度（R4：缺数据本身成为叙事）——与 /stats、/about 同源，构建期实测，不手写数字
const cov = coverageStats();
const coverage = [
  { label: '状元名录收录', cur: cov.zhuangyuan, total: GOALS.persons },
  { label: '全字段档案', cur: cov.fullProfile.cur, total: GOALS.fullProfile },
  { label: '故事', cur: cov.stories.published, total: GOALS.stories },
];
---
<html lang="zh-CN">
  <head>
    <SeoHead title="状元谱 · 历代状元的人生轨迹" description="自唐武德五年（622）孙伏伽至清光绪三十年（1904）刘春霖，历代文状元人生轨迹：长篇故事 + 可查证的数据底座。" path="/" />
  </head>
  <body>
    <div class="container">
      <header class="site-head">
        <h1>状元谱</h1>
        <p class="sub">622 年孙伏伽 — 1904 年刘春霖：一千二百八十三年，已录 <b>{cov.zhuangyuan}</b> 位「天下第一」的人生</p>
        <nav class="site-nav">
          <a href={`${BASE}stories/`}>故事</a>
          <a href={`${BASE}search/`}>检索</a>
          <a href={`${BASE}map/`}>籍贯地图</a>
          <a href={`${BASE}galaxy/`}>星图</a>
          <a href={`${BASE}timeline/`}>时间线</a>
          <a href={`${BASE}stats/`}>统计</a>
          <a href={`${BASE}persons/`}>人物索引（{persons.length}）</a>
          <a href={`${BASE}corrections/`}>勘误</a>
          <a href={`${BASE}about/`}>关于</a>
        </nav>
      </header>

      {featured && (
        <a class="feature" href={`${BASE}stories/${featured.slug}/`}>
          <span class="feature-tag">本期主打</span>
          <h2>{featured.title}</h2>
          {featured.subtitle && <p class="feature-sub">{featured.subtitle}</p>}
          {featured.intro && <p class="feature-intro">{featured.intro}</p>}
          <span class="feature-go">阅读全文 →</span>
        </a>
      )}

      <a class="galaxy-entry" href={`${BASE}galaxy/`}>
        <span class="ge-body">
          <span class="ge-tag">可视化 · 星图</span>
          <h2>状元星河 · 一眼望尽 1283 年</h2>
          <p class="ge-desc">
            {galaxy
              ? `${galaxy.n} 个人物的科年与朝代，化作一片金点星河：横轴 ${galaxy.from}—${galaxy.to} 年，纵轴八朝分带，金亮者皆有其传。`
              : '历代状元的科年与朝代，化作一片金点星河：横轴千年，纵轴八朝，金亮者皆有其传。'}
          </p>
          <span class="ge-meta">
            {galaxy && <span class="ge-chip">{galaxy.n} 星点</span>}
            {galaxy && <span class="ge-chip">金亮 {galaxy.gold}</span>}
            <span class="ge-chip">八朝分带</span>
            <span class="ge-chip">可拖拽缩放</span>
          </span>
          <span class="ge-go">入河观星 →</span>
        </span>
      </a>

      {rest.length > 0 && (
        <section class="flow">
          {rest.map((s) => (
            <a class="flow-item" href={`${BASE}stories/${s.slug}/`}>
              <h3>{s.title}</h3>
              {s.subtitle && <p>{s.subtitle}</p>}
            </a>
          ))}
        </section>
      )}

      <section class="plan">
        <h2>补全计划</h2>
        <p class="plan-note">历代榜上有名者六百余人，本站已录状元 {cov.zhuangyuan} 人（另收特例 {cov.roles.special} 人）；史中留痕者寥寥。缺漏不遮不掩，进度公开——这本身就是本站要讲的故事。</p>
        <div class="plan-bars">
          {coverage.map((c) => (
            <div class="bar-row">
              <span class="bar-label">{c.label}</span>
              <span class="bar-track">
                <span class="bar-fill" style={`width:${Math.min(100, (c.cur / c.total) * 100).toFixed(1)}%`}></span>
              </span>
              <span class="bar-num">{c.cur} / {c.total}</span>
            </div>
          ))}
        </div>
      </section>

      <section>
        <h2 class="sec-title">已建全字段档案</h2>
        <div class="grid">
          {withEvents.map((p) => {
            const st = profileStatusText(p);
            const special = isSpecialRole(p);
            return (
              <a class="card" href={`${BASE}persons/${p.id}/`}>
                <h2>{p.name}
                  {special && <span class={`role-badge role-${roleOf(p)}`} title={ROLE_NOTE[roleOf(p)]}>{ROLE_LABEL[roleOf(p)]}</span>}
                </h2>
                <span class="rank">{p.rank_detail ?? ''}</span>
                <p class="meta">
                  {p.dynasty}{p.exam_year ? ` · ${p.exam_year}（${p.ganzhi ?? '？'}）` : ''}
                  {p.birth_year ? ` · ${p.birth_year}–${p.death_year ?? '？'}` : ''}
                </p>
                <p class={`bio bio-${st.status}`}>{st.label}</p>
              </a>
            );
          })}
        </div>
        <a class="back" href={`${BASE}persons/`}>→ 全量人物索引（{persons.length} 人）</a>
      </section>
    </div>

    <style>
      .site-nav { margin-top: 0.9rem; display: flex; gap: 0.4rem; flex-wrap: wrap; }
      .site-nav a {
        font-size: 0.8rem; text-decoration: none; color: var(--ink);
        border: 1px solid var(--line); padding: 0.1rem 0.6rem; border-radius: 2px;
        background: #fbf8f0;
      }
      .site-nav a:hover { color: var(--cinnabar); border-color: var(--cinnabar); }

      .feature {
        display: block; text-decoration: none; color: inherit; margin-bottom: 1.6rem;
        border: 2px solid var(--ink); background: #fbf8f0; padding: 1.6rem 1.6rem 1.2rem;
        border-radius: 4px; position: relative;
      }
      .feature:hover { box-shadow: 4px 4px 0 var(--ink); }
      .feature-tag {
        position: absolute; top: -0.7rem; left: 1.2rem; background: var(--cinnabar);
        color: #fff; font-size: 0.72rem; padding: 0.1rem 0.6rem; border-radius: 2px; letter-spacing: 0.15em;
      }
      .feature h2 { margin: 0.2rem 0 0.3rem; font-size: 1.55rem; line-height: 1.45; }
      .feature-sub { margin: 0 0 0.6rem; color: var(--cinnabar); font-size: 0.95rem; }
      .feature-intro { margin: 0; color: var(--ink-soft); font-size: 0.92rem; }
      .feature-go { display: inline-block; margin-top: 0.8rem; font-size: 0.85rem; color: var(--cinnabar); }

      /* 星图入口卡：深色星河（与 /galaxy/ 夜模式同源），独立于宣纸风专题流 */
      .galaxy-entry {
        display: block; position: relative; overflow: hidden; text-decoration: none;
        margin-bottom: 2.2rem; padding: 1.5rem 1.6rem 1.3rem;
        border: 1px solid var(--gold); border-radius: 4px;
        background: radial-gradient(125% 170% at 84% 8%, #1e2b46 0%, #141d2f 44%, #0b111e 100%);
        box-shadow: 0 6px 22px rgba(18, 24, 38, 0.26);
      }
      /* 点阵（纯 CSS，无脚本）：确定性星点，避免与正文抢注意力 */
      .galaxy-entry::before {
        content: ''; position: absolute; inset: 0; pointer-events: none; opacity: 0.85;
        background-image:
          radial-gradient(1.5px 1.5px at 8% 22%, rgba(232,217,168,0.95), transparent 62%),
          radial-gradient(1px 1px at 15% 68%, rgba(168,172,180,0.7), transparent 60%),
          radial-gradient(1.3px 1.3px at 24% 38%, rgba(212,175,55,0.85), transparent 62%),
          radial-gradient(1px 1px at 31% 82%, rgba(232,226,208,0.6), transparent 60%),
          radial-gradient(1.6px 1.6px at 42% 18%, rgba(232,217,168,0.9), transparent 62%),
          radial-gradient(1px 1px at 49% 61%, rgba(168,172,180,0.65), transparent 60%),
          radial-gradient(2px 2px at 58% 30%, rgba(232,217,168,1), transparent 62%),
          radial-gradient(1px 1px at 63% 76%, rgba(158,43,34,0.85), transparent 60%),
          radial-gradient(1.4px 1.4px at 71% 52%, rgba(212,175,55,0.8), transparent 62%),
          radial-gradient(1px 1px at 78% 14%, rgba(232,226,208,0.6), transparent 60%),
          radial-gradient(1.8px 1.8px at 86% 66%, rgba(232,217,168,0.9), transparent 62%),
          radial-gradient(1px 1px at 92% 34%, rgba(168,172,180,0.6), transparent 60%),
          radial-gradient(1.3px 1.3px at 96% 82%, rgba(212,175,55,0.75), transparent 62%),
          radial-gradient(1px 1px at 4% 46%, rgba(232,226,208,0.55), transparent 60%);
      }
      .ge-body { position: relative; z-index: 1; display: block; }
      .ge-tag {
        display: inline-block; font-size: 0.7rem; letter-spacing: 0.18em;
        color: #0e1420; background: var(--gold); border-radius: 2px; padding: 0.05rem 0.5rem;
      }
      .galaxy-entry h2 {
        margin: 0.7rem 0 0.5rem; font-size: 1.5rem; line-height: 1.4;
        color: #e8d9a8; letter-spacing: 0.06em;
      }
      .ge-desc { margin: 0 0 0.9rem; font-size: 0.9rem; line-height: 1.85; color: rgba(232, 226, 208, 0.78); }
      .ge-meta { display: flex; flex-wrap: wrap; gap: 0.5rem; }
      .ge-chip {
        font-size: 0.74rem; color: #d4af37;
        border: 1px solid rgba(169, 139, 63, 0.6); border-radius: 999px; padding: 0.02rem 0.6rem;
      }
      .ge-go { display: inline-block; margin-top: 0.9rem; font-size: 0.85rem; color: #d4af37; }
      .galaxy-entry:hover { border-color: #d4af37; box-shadow: 0 8px 30px rgba(18, 24, 38, 0.42); }
      .galaxy-entry:hover .ge-go { text-decoration: underline; }

      .flow { display: grid; gap: 0.8rem; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); margin-bottom: 2.2rem; }
      .flow-item {
        display: block; text-decoration: none; color: inherit; border: 1px solid var(--line);
        background: #fbf8f0; padding: 1rem 1.1rem; border-radius: 4px;
      }
      .flow-item:hover { box-shadow: 0 2px 10px rgba(43,42,38,0.12); }
      .flow-item h3 { margin: 0 0 0.3rem; font-size: 1.05rem; }
      .flow-item p { margin: 0; font-size: 0.85rem; color: var(--ink-soft); }

      .plan { border: 1px dashed var(--gold); border-radius: 4px; padding: 1rem 1.2rem; margin-bottom: 2.2rem; background: var(--paper-deep); }
      .plan h2 { margin: 0 0 0.3rem; font-size: 1.05rem; letter-spacing: 0.2em; }
      .plan-note { margin: 0 0 0.9rem; font-size: 0.85rem; color: var(--ink-soft); }
      .bar-row { display: flex; align-items: center; gap: 0.8rem; margin: 0.45rem 0; font-size: 0.82rem; }
      .bar-label { width: 5.5em; color: var(--ink-soft); }
      .bar-track { flex: 1; height: 8px; background: #e4dccb; border-radius: 4px; overflow: hidden; }
      .bar-fill { display: block; height: 100%; background: var(--cinnabar); border-radius: 4px; }
      .bar-num { width: 5.5em; text-align: right; color: var(--ink-soft); font-variant-numeric: tabular-nums; }

      .sec-title { font-size: 1.15rem; letter-spacing: 0.15em; border-top: 2px solid var(--ink); padding-top: 1rem; }
      .quelu { color: var(--ink-soft); }

      @media (max-width: 640px) {
        .feature h2 { font-size: 1.25rem; }
        .bar-label { width: 4.5em; }
        .galaxy-entry { padding: 1.2rem 1.1rem 1.1rem; }
        .galaxy-entry h2 { font-size: 1.2rem; }
      }
    </style>
  </body>
</html>
