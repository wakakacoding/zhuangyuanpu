---
import { allPersons, allSources, subDocs, ganzhiOf, reignYearOf, profileStatusText, roleOf, ROLE_LABEL, ROLE_NOTE, BASE} from '../../lib/persons';
import SeoHead from '../../components/SeoHead.astro';
import CareerRiver from '../../components/CareerRiver.astro';
import '../../styles/base.css';
import '../../styles/profile.css';

export function getStaticPaths() {
  const sources = allSources();
  return allPersons().map((person) => ({
    params: { id: person.id },
    props: {
      person,
      events: subDocs('events', person.id),
      works: subDocs('works', person.id),
      anecdotes: subDocs('anecdotes', person.id),
      relations: subDocs('relations', person.id),
      sources,
    },
  }));
}

const { person, events, works, anecdotes, relations, sources } = Astro.props;
const srcOf = (sid: string) => sources[sid];

// 名录身份（R1.4-2）：特例（探花／事实状元）须在档案页明示，不冒充状元
const role = roleOf(person);
const isSpecial = role !== 'zhuangyuan';
// 档案状态分层（R1.4-5）：待整理 = 整理进度；史料阙如 = 已人工查证
const bio = profileStatusText(person);

const TIER_LABEL: Record<string, string> = { A: '正史', B: '方志·笔记', C: '传说' };
const topTierOf = (ids: string[] = []) => {
  const tiers = ids.map((s) => sources[s]?.tier).filter(Boolean);
  return tiers.includes('A') ? 'A' : tiers.includes('B') ? 'B' : 'C';
};
// 生平事件按年排序（构建期一次）
const sortedEvents = [...events].sort((a, b) => a.year - b.year);
const yearLabel = (e: any) =>
  `${e.year}${e.year_end ? `–${e.year_end}` : ''}${e.year_precision === 'about' ? '（约）' : ''}`;
---
<html lang="zh-CN">
  <head>
    <SeoHead title={person.name} description={person.bio_short ?? `${person.name}，${person.dynasty}代${ROLE_LABEL[role]}。`} path={`/persons/${person.id}/`} />
  </head>
  <body>
    <div class="container">
      <nav class="crumb"><a href={BASE}>首页</a> / <a href={`${BASE}persons/`}>索引</a> / <a href={`${BASE}search/`}>检索</a></nav>

      <header class="profile-head">
        <h1>{person.name}
          {isSpecial && <span class={`role-badge role-badge-lg role-${role}`} title={ROLE_NOTE[role]}>{ROLE_LABEL[role]}</span>}
          {(person.zi || person.hao) && (
            <span class="zhi">{person.zi ? `字${person.zi}` : ''}{person.zi && person.hao ? '，' : ''}{person.hao ? `号${person.hao}` : ''}</span>
          )}
        </h1>
        {person.tags?.length > 0 && <div class="tags">{person.tags.map((t) => <span>{t}</span>)}</div>}
      </header>

      {/* 名录身份说明（R1.4-2）：特例收录者不是状元，须在档案页讲清名分 */}
      {isSpecial && (
        <p class="role-flag">
          <span class={`role-badge role-${role}`}>{ROLE_LABEL[role]}</span>
          此人为<b>特例收录</b>：{ROLE_NOTE[role]}。因科举史料价值立卡，<b>不计入本站状元总数与各分布统计</b>。
        </p>
      )}

      {/* 身份匹配存疑徽标（R1.1-4）：CBDB 候选匹配未核实者不再静默展示 */}
      {person.identity_status === 'suspect' && (
        <p class="id-flag">
          <span class="id-badge">身份匹配存疑</span>
          此人系 CBDB 候选比对所得，未经题名碑录／《登科记考》核验，是否即名录上之本人尚无定论；卡上信息仅供参考，待人工考证（见 <a href={`${BASE}corrections/`}>补全计划</a>）。
        </p>
      )}

      <table class="fact-table">
        <tbody>
          <tr><th>生卒</th><td>{(person.birth_year || person.death_year) ? `${person.birth_year || '？'}–${person.death_year ?? '？'}（${person.birth_year ? ganzhiOf(person.birth_year) : '？'}–${person.death_year ? ganzhiOf(person.death_year) : '？'}）` : <span class="quelu">待考</span>}</td></tr>
          <tr><th>朝代 / 帝号</th><td>{person.dynasty}{person.reign ? ` / ${person.reign}` : ''}</td></tr>
          <tr><th>科年</th><td>{person.exam_year ? <>{person.exam_year}（{person.ganzhi ?? ganzhiOf(person.exam_year)}）{reignYearOf(person.exam_year) && <span class="reign-mark">{reignYearOf(person.exam_year)}</span>}{person.ke_ci ? ` · ${person.ke_ci}` : ''}</> : <span class="quelu">待考</span>}</td></tr>
          <tr><th>榜次</th><td>{person.rank_detail ?? <span class="quelu">待考</span>}</td></tr>
          <tr><th>籍贯（历史）</th><td>{person.native_hist ?? <span class="quelu">待考</span>}</td></tr>
          <tr><th>籍贯（今）</th><td>{person.native_modern ?? <span class="quelu">待考</span>}{person.lat != null && `（${person.lat}, ${person.lng}）`}</td></tr>
        </tbody>
      </table>

      <p class={`bio bio-${bio.status}`}>{bio.label}</p>
      {bio.hint && <p class="bio-hint">{bio.hint}</p>}
      <p class="note-line" style="font-size:0.8rem;">表中「待考」= 尚未考出，属整理进度；只有经人工查证确认无载者，才表述为「史料阙如」。</p>

      {/* 仕途河流图：整块位于「仕途时间线」一节之上；仕途事件 <3 条自动不渲染（阙如合法） */}
      <CareerRiver events={sortedEvents} deathYear={person.death_year ?? null} sources={sources} personName={person.name} />

      <h2 class="section-title">仕途时间线</h2>
      {sortedEvents.length === 0 ? (
        <p class="quelu">事件档案未建。<a href={`${BASE}corrections/`}>了解补全计划 →</a></p>
      ) : (
        <ol class="timeline-v2">
          {sortedEvents.map((e, i) => {
            const top = topTierOf(e.source_ids);
            const isPeak = e.type === '夺魁';
            return (
              <li id={`ev-${i}`} class={`tl-item tier-${top}${isPeak ? ' peak' : ''}`}>
                <div class="tl-year">
                  <b>{yearLabel(e)}</b>
                  <span class="tl-gz">{ganzhiOf(e.year)}</span>
                  {reignYearOf(e.year) && <span class="tl-reign">{reignYearOf(e.year)}</span>}
                </div>
                <div class="tl-body">
                  <div class="tl-title">
                    <span class={`ev-type${isPeak ? ' ev-peak' : ''}`}>{e.type}</span>
                    <b>{e.title}</b>
                  </div>
                  {e.description && <p>{e.description}</p>}
                  {(e.source_ids ?? []).length > 0 && (
                    <div class="src-panel">
                      {(e.source_ids ?? []).map(srcOf).filter(Boolean).map((s: any) => (
                        <details class={`src src-tier-${s.tier}`}>
                          <summary>
                            <span class={`tier tier-${s.tier}`}>{s.tier}</span>
                            <span class="src-kind">{TIER_LABEL[s.tier]}</span>
                            {s.title}{s.juan ? ` · ${s.juan}` : ''}
                          </summary>
                          {s.quote && <blockquote>{s.quote}</blockquote>}
                          {s.note && <p class="note">{s.note}</p>}
                        </details>
                      ))}
                    </div>
                  )}
                </div>
              </li>
            );
          })}
        </ol>
      )}

      {relations.length > 0 && (
        <>
          <h2 class="section-title">人物关系</h2>
          <ul>
            {relations.map((r) => (
              <li>
                <a href={`${BASE}persons/${r.to_id}/`}>{r.to_id}</a>（{r.type}）——{r.note}
              </li>
            ))}
          </ul>
        </>
      )}

      {works.length > 0 && (
        <>
          <h2 class="section-title">著作</h2>
          <ul>
            {works.map((w) => (
              <li>《{w.title}》（{w.type} · {w.status}）{w.note ? `——${w.note}` : ''}</li>
            ))}
          </ul>
        </>
      )}

      {anecdotes.length > 0 && (
        <>
          <h2 class="section-title">轶事与传说</h2>
          <p class="legend-note">以下属传说层级（C 级），与上方史实物理隔离，不作定论依据。</p>
          {anecdotes.map((a) => (
            <div class="anecdote">
              <h3>{a.title}<span class="legend-tag">传说 · {a.tier} 级</span></h3>
              <p>{a.content}</p>
              {a.note && <p class="note" style="color: var(--ink-soft); font-size: 0.8rem;">备考：{a.note}</p>}
            </div>
          ))}
        </>
      )}

      <a class="back" href={`${BASE}persons/`}>← 返回索引</a>
    </div>
  </body>
</html>
