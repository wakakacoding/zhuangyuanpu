---
import { allPersons, presentDynasties, fullProfileIds, roleOf, ROLE_LABEL, ROLE_NOTE, BASE, traditionalNames} from '../lib/persons';
import SeoHead from '../components/SeoHead.astro';
import SiteNav from '../components/SiteNav.astro';
import '../styles/base.css';
import '../styles/search.css';

const persons = allPersons();
const fullIds = fullProfileIds();

// 繁简双匹配（R3-2b）：姓名 → 繁体名取自 data/index/zhuangyuan_index.yaml 的 name_tw，
// 构建期注入检索 idx，于是「劉春霖」与「刘春霖」都能命中同一张卡。
// 比在前端用 OpenCC 转换查询词更稳：查询词不必变，两侧写法都在索引里。
const nameTw = traditionalNames();

// 单页最多渲染的结果条数：超出则列表顶部提示，引导用户加筛选条件
const RESULT_LIMIT = 500;

// 口径（R1.4-2）：库里是「人物卡」，其中状元与特例分列——标题不写「N 位状元」
const nZhuangyuan = persons.filter((p) => roleOf(p) === 'zhuangyuan').length;
const nSpecial = persons.length - nZhuangyuan;

// 构建期生成精简检索索引（内嵌页面，客户端过滤，响应 <200ms）
const index = persons.map((p) => ({
  id: p.id,
  n: p.name,
  // 繁体别名：仅在异于简体名时写入，省字节（多数姓名 418/597 会不同）
  tw: nameTw[p.name] && nameTw[p.name] !== p.name ? nameTw[p.name] : '',
  zi: p.zi ?? '',
  hao: p.hao ?? '',
  d: p.dynasty,
  y: p.exam_year ?? null,
  gz: p.ganzhi ?? '',
  kc: p.ke_ci ?? '',
  rk: p.rank_detail ?? '',
  nh: p.native_hist ?? '',
  nm: p.native_modern ?? '',
  tg: p.tags ?? [],
  bio: (p.bio_short ?? '').slice(0, 90),
  full: fullIds.has(p.id) ? 1 : 0,
  // 名录身份：仅特例携带（状元缺省），供结果卡片渲染身份徽标
  role: roleOf(p) === 'zhuangyuan' ? '' : roleOf(p),
  roleLabel: roleOf(p) === 'zhuangyuan' ? '' : ROLE_LABEL[roleOf(p)],
  roleNote: roleOf(p) === 'zhuangyuan' ? '' : ROLE_NOTE[roleOf(p)],
}));

const dynasties = presentDynasties(persons);
const allTags = [...new Set(persons.flatMap((p) => p.tags ?? []))].sort();
const years = persons.map((p) => p.exam_year).filter(Boolean);
const yMin = Math.min(...years);
const yMax = Math.max(...years);
---
<html lang="zh-CN">
  <head>
    <SeoHead title="检索" description="历代状元组合检索：朝代、科年区间、籍贯、标签自由组合，构建期索引，毫秒响应。" path="/search/" />
  </head>
  <body>
    <div class="container container-wide">
      <header class="site-head">
        <h1>检索</h1>
        <p class="sub">状元 {nZhuangyuan} 人 · 特例 {nSpecial} 人（探花／事实状元，见卡面徽标） · 朝代 / 科年 / 籍贯 / 标签自由组合</p>
        <SiteNav current="/search/" />
      </header>

      <section class="filters">
        <div class="f-row">
          <input id="q" type="search" placeholder="姓名、字号、籍贯、关键词…" autocomplete="off" />
          <select id="tag">
            <option value="">全部标签</option>
            {allTags.map((t) => <option value={t}>{t}</option>)}
          </select>
        </div>
        <div class="f-row">
          <div class="dyn-chips" id="dynChips">
            {dynasties.map((d) => <button type="button" class="chip" data-d={d}>{d}</button>)}
          </div>
          <div class="year-range">
            <input id="yFrom" type="number" placeholder={String(yMin)} min={yMin} max={yMax} aria-describedby="yearWarn" />
            <span>—</span>
            <input id="yTo" type="number" placeholder={String(yMax)} min={yMin} max={yMax} aria-describedby="yearWarn" />
            <p id="yearWarn" class="year-warn" hidden>
              起始年晚于结束年
              <button id="yearSwap" type="button">交换</button>
            </p>
          </div>
        </div>
        <div class="f-row f-meta">
          <span id="count"></span>
          <label class="full-only"><input id="fullOnly" type="checkbox" /> 仅看全字段档案</label>
          <button id="reset" type="button">清空条件</button>
        </div>
      </section>

      <ul id="results" class="results"></ul>

      <a class="back" href={BASE}>← 返回首页</a>
    </div>

    <script type="application/json" id="idx" data-limit={String(RESULT_LIMIT)} set:html={JSON.stringify(index)} />
    <script>
      const BASE = import.meta.env.BASE_URL;
      const idxEl = document.getElementById('idx') as HTMLScriptElement;
      const idx = JSON.parse(idxEl.textContent || '[]');
      const LIMIT = parseInt((idxEl.dataset.limit as string) || '', 10) || 500;
      const qEl = document.getElementById('q') as HTMLInputElement;
      const tagEl = document.getElementById('tag') as HTMLSelectElement;
      const yFromEl = document.getElementById('yFrom') as HTMLInputElement;
      const yToEl = document.getElementById('yTo') as HTMLInputElement;
      const countEl = document.getElementById('count') as HTMLElement;
      const listEl = document.getElementById('results') as HTMLUListElement;
      const fullEl = document.getElementById('fullOnly') as HTMLInputElement;
      const yearWarnEl = document.getElementById('yearWarn') as HTMLElement;
      const resetEl = document.getElementById('reset') as HTMLButtonElement;
      const yearSwapEl = document.getElementById('yearSwap') as HTMLButtonElement;
      const activeDyn = new Set();

      // URL hash 同步：#q=..&dyn=唐宋&y=1400-1500&tag=..&full=1
      // 程序写 hash 时置位，避免 replaceState 之外的自身回声触发二次重置。
      let applyingHash = false;
      function toHash() {
        const p = new URLSearchParams();
        if (qEl.value.trim()) p.set('q', qEl.value.trim());
        if (activeDyn.size) p.set('dyn', [...activeDyn].join(','));
        const yf = yFromEl.value, yt = yToEl.value;
        if (yf || yt) p.set('y', `${yf || ''}-${yt || ''}`);
        if (tagEl.value) p.set('tag', tagEl.value);
        if (fullEl.checked) p.set('full', '1');
        const next = p.toString() ? '#' + p : '';
        if ((location.hash || '') === next) return;
        applyingHash = true;
        history.replaceState(null, '', next || location.pathname);
        applyingHash = false;
      }
      // 先清空全部条件，再按 hash 应用，避免同页改 hash / 前进后退时旧条件残留。
      function clearFilters() {
        qEl.value = ''; tagEl.value = ''; yFromEl.value = ''; yToEl.value = '';
        fullEl.checked = false; activeDyn.clear();
        document.querySelectorAll('.chip.on').forEach((c) => c.classList.remove('on'));
      }
      function fromHash() {
        clearFilters();
        const p = new URLSearchParams(location.hash.slice(1));
        if (p.get('q')) qEl.value = p.get('q') || '';
        if (p.get('dyn')) (p.get('dyn') || '').split(',').forEach((c: string) => {
          const chip = document.querySelector(`.chip[data-d="${CSS.escape(c)}"]`);
          if (chip && !activeDyn.has(c)) { activeDyn.add(c); chip.classList.add('on'); }
        });
        const yRaw = p.get('y');
        if (yRaw) {
          const cut = yRaw.indexOf('-');
          // 只按第一个连字符切开，负年号不会被拆碎；无连字符视为仅起始年。
          yFromEl.value = cut < 0 ? yRaw : yRaw.slice(0, cut);
          yToEl.value = cut < 0 ? '' : yRaw.slice(cut + 1);
        }
        const tagRaw = p.get('tag');
        if (tagRaw) tagEl.value = tagRaw;
        if (p.get('full') === '1') fullEl.checked = true;
      }
      // 两端都填且起始年晚于结束年：就地提示，不走结果区「无命中」。空端点 = 不限制。
      function yearInverted() {
        if (yFromEl.value === '' || yToEl.value === '') return false;
        const yf = parseInt(yFromEl.value, 10);
        const yt = parseInt(yToEl.value, 10);
        return Number.isFinite(yf) && Number.isFinite(yt) && yf > yt;
      }

      interface IdxPerson { n: string; tw?: string; zi?: string; hao?: string; nh?: string; nm?: string; kc?: string; rk?: string; bio?: string; d: string; y: number | null; gz?: string; tg: string[]; full?: boolean; s?: string; id?: string; role?: string; roleNote?: string; roleLabel?: string; }
      function match(p: IdxPerson) {
        if (fullEl.checked && !p.full) return false;
        if (activeDyn.size && !activeDyn.has(p.d)) return false;
        const yf = parseInt(yFromEl.value) || -Infinity;
        const yt = parseInt(yToEl.value) || Infinity;
        if (p.y == null) { if (yf !== -Infinity || yt !== Infinity) return false; }
        else if (p.y < yf || p.y > yt) return false;
        if (tagEl.value && !p.tg.includes(tagEl.value)) return false;
        const q = qEl.value.trim();
        if (q) {
          // p.tw = 繁体别名（见文件头 frontmatter），与简体名同列，故「劉春霖」可直接命中刘春霖
          const hay = [p.n, p.tw, p.zi, p.hao, p.nh, p.nm, p.kc, p.rk, p.bio, p.tg.join(' ')].join(' ');
          if (!q.split(/\s+/).every((w) => hay.includes(w))) return false;
        }
        return true;
      }

      function esc(s: string) {
        return s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
      }

      // 繁体模式下，结果区是运行期重绘的简体文本，须按当前语言再过一次转换
      //（转换器与人名保护表都在 SeoHead 里懒加载，这里只借用，不重复实现）。
      // 与 R3-2c 有关：重绘只重建列表 DOM，**从不触碰任何筛选控件**，故切语言不丢筛选状态。
      function syncLang() {
        const api = (window as any).__zypLang;
        if (api) api.convert(listEl);
      }

      function render() {
        const inverted = yearInverted();
        yearWarnEl.hidden = !inverted;
        yFromEl.setAttribute('aria-invalid', inverted ? 'true' : 'false');
        yToEl.setAttribute('aria-invalid', inverted ? 'true' : 'false');
        if (inverted) {
          countEl.textContent = '';
          listEl.innerHTML = '';
          toHash();
          return;
        }
        const hits = (idx as IdxPerson[]).filter(match);
        countEl.textContent = `命中 ${hits.length} / ${idx.length} 人`;
        if (!hits.length) {
          listEl.innerHTML = '<li class="none">无命中——换个条件试试。「阙如」亦是史料的一部分。</li>';
        } else {
          // 命中超过单页上限：顶部明示截断，避免用户误以为这就是全部结果
          const notice = hits.length > LIMIT
            ? `<li class="trunc-note">仅显示前 ${LIMIT} 条，请加筛选条件缩小范围</li>`
            : '';
          listEl.innerHTML = notice + hits.slice(0, LIMIT).map((p) => `
          <li class="hit">
            <a href="${BASE}persons/${p.id}/">
              <b>${esc(p.n)}</b>
              ${p.role ? `<span class="role-badge role-${esc(p.role)}" title="${esc(p.roleNote || '')}">${esc(p.roleLabel || '')}</span>` : ''}
              ${p.full ? '<span class="full-badge">全档案</span>' : ''}
              <span class="hit-meta">${p.d}${p.y ? ` · ${p.y}（${p.gz}）` : ' · 科年阙如'}${p.nh ? ` · ${esc(p.nh)}` : ''}</span>
              ${p.tg.length ? `<span class="hit-tags">${p.tg.map((t) => `<i>${esc(t)}</i>`).join('')}</span>` : ''}
              ${p.bio ? `<span class="hit-bio">${esc(p.bio)}…</span>` : ''}
            </a>
          </li>`).join('');
        }
        toHash();
        syncLang();
      }

      document.querySelectorAll<HTMLElement>('.chip').forEach((chip) => {
        chip.addEventListener('click', () => {
          const d = (chip.dataset.d as string) || '';
          activeDyn.has(d) ? activeDyn.delete(d) : activeDyn.add(d);
          chip.classList.toggle('on');
          render();
        });
      });
      [qEl, tagEl, yFromEl, yToEl, fullEl].forEach((el) => {
        el.addEventListener('input', render);
        el.addEventListener('change', render);
      });
      resetEl.addEventListener('click', () => {
        clearFilters();
        render();
      });
      yearSwapEl.addEventListener('click', () => {
        const a = yFromEl.value;
        yFromEl.value = yToEl.value;
        yToEl.value = a;
        render();
      });

      // 同文档改 hash、以及前进/后退：完整重置后再按 hash 恢复。
      // 后退改 hash 时 popstate 与 hashchange 会连续到，合并成一次恢复。
      // replaceState 不触发这两个事件；自身写 hash 期间忽略回声。
      let restoreQueued = false;
      function restoreFromLocation() {
        if (applyingHash || restoreQueued) return;
        restoreQueued = true;
        queueMicrotask(() => {
          restoreQueued = false;
          if (applyingHash) return;
          fromHash();
          render();
        });
      }
      window.addEventListener('hashchange', restoreFromLocation);
      window.addEventListener('popstate', restoreFromLocation);

      fromHash();
      render();
    </script>
  </body>
</html>
